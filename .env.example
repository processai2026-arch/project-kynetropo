# Copy to .env in the project root (on the server: the deployment root, next to
# api/). api/config/*.php and database/migrate.php read it; Vite reads the
# VITE_* keys at build time. Never commit the real .env.

# ── App database ────────────────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ── Control-plane database (tenants, plans). Falls back to DB_* when blank ──
CP_DB_HOST=
CP_DB_NAME=saas_control
CP_DB_USER=
CP_DB_PASS=

# ── Security ────────────────────────────────────────────────────────────────
# 64 hex chars: php -r "echo bin2hex(random_bytes(32));"
JWT_SECRET=
# Browser origins allowed to call the API, comma-separated
CORS_ORIGIN=https://project.kynetropo.com
APP_ENV=production

# ── Multi-tenancy ───────────────────────────────────────────────────────────
TENANCY_ENABLED=false
FOUNDING_TENANT_ID=1
TENANT_RESOLUTION=subdomain
APP_ROOT_DOMAIN=
# 32-byte key (hex or base64) for tenant DB passwords
TENANT_ENC_KEY=

# ── Optional integrations (leave blank to keep a feature off) ───────────────
groq_api_key=
groq_api_key_new=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Kynetropo
APP_PUBLIC_URL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Shared secret for calling api/cron/* over HTTP (X-Cron-Key header)
CRON_KEY=

# ── Web app build (Vite exposes only VITE_* to the browser bundle) ──────────
# Local dev with `npm run api:serve`: http://127.0.0.1:8020/api
# Releases are built with /api (same origin) by scripts/build-release.mjs.
VITE_API_BASE_URL=/api
VITE_USE_MOCK_API=false

# Sales AI assistant (api/controllers/SalesAiChatController.php)
# AI_PROVIDER is gemini or groq. APP_URL is optional: the site URL the assistant
# calls back into (defaults to the current request's host).
AI_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_FALLBACK_MODEL=
GROQ_API_KEY=
GROQ_MODEL=
APP_URL=
