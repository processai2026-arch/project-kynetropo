# Secrets — never commit. .env holds live DB credentials, the JWT secret and
# API keys; api/config reads it from the project root.
.env
.env.*
!.env.example

# Dependencies
node_modules/

# Build output
dist/
dist-customer/
dist-dealer/

# Packaged deployables (node scripts/build-release.mjs)
release/
release-*/

# Logs
*.log
error_log
api/cron/cron.log

# Runtime files written by the API — customer data and backups, not source.
api/uploads/*
!api/uploads/.gitkeep
api/storage/
api/backups/

# Deployment artifacts — contain secrets, never commit
deploy/
api/run_migrate.php

# OS / editor
.DS_Store
Thumbs.db
.vscode/*
!.vscode/sftp.json.example
