# Built frontend copied into the web root by a deploy. These are OUTPUT, not
# source: `npm run build` regenerates them into dist/. Committing them is what
# previously overwrote the Vite entry template and broke the build — the source
# template now lives at app.html, and index.html is a build artifact only.
/index.html
/assets/
