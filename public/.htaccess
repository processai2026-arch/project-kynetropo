Options -Indexes
RewriteEngine On
RewriteBase /

# ── Deny rules ────────────────────────────────────────────────────────────
# These MUST come before the SPA rewrite below, which skips real directories:
# without them a migration script or schema file would be served as-is.
# database/ ships with every release (scripts/build-release.mjs) and is run
# from SSH only; the rest never ships but is denied in case it is uploaded.
RewriteRule ^(database|node_modules|src|tests|scripts|docs)/ - [F,L]

# Nothing with these extensions is ever a public asset.
RewriteRule \.(sql|env|log|md|sh|bak|gz|tgz|ini|yml|yaml)$ - [F,L]

# Dotfiles (.env, .git, editor leftovers), except .well-known/ which SSL
# certificate renewal needs.
RewriteRule (^|/)\.(?!well-known(/|$)) - [F,L]

# ── SPA routing ───────────────────────────────────────────────────────────
# Don't rewrite real files or directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Don't rewrite /api/ requests — let PHP handle them
RewriteCond %{REQUEST_URI} !^/api/

# Everything else → React SPA
RewriteRule ^(.*)$ index.html [QSA,L]

# Correct MIME type for the web app manifest, so the browser accepts it
# and the app is offered as installable.
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
</IfModule>

# No-cache for index.html (always serve latest deploy)
<Files "index.html">
  Header always set Cache-Control "no-cache, no-store, must-revalidate"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</Files>

# Long-term cache for hashed assets.
# sw.js is deliberately excluded: it is NOT content-hashed, and an immutable
# year-long cache would pin every installed app to the service worker shipped
# on the day it was installed.
<FilesMatch "^(?!sw\.js$).*\.(js|css|png|jpg|jpeg|svg|ico|woff|woff2|ttf)$">
  Header always set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>

# The service worker and the manifest must always be revalidated so a deploy
# actually reaches installed apps. Listed after the block above so these win.
<Files "sw.js">
  Header always set Cache-Control "no-cache, no-store, must-revalidate"
  Header always set Pragma "no-cache"
  Header always set Expires "0"
</Files>
<Files "manifest.webmanifest">
  Header always set Cache-Control "no-cache, must-revalidate"
</Files>
